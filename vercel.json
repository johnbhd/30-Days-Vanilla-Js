{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/download/CalConverter",
      "destination": "/public/download/CalConverter.apk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/public/download/CalConverter.apk",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"CalConverter.apk\""
        },
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        }
      ]
    }
  ]
}